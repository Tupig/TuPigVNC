<Window x:Class="TuPigVNC.Wpf.Dialogs.AuthDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VNC 认证"
        Width="410"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CardBrush}"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        ShowInTaskbar="False"
        SourceInitialized="Window_SourceInitialized">

    <StackPanel Margin="20">

        <!-- 顶部安全状态横幅 -->
        <Border x:Name="SecureBanner" CornerRadius="8" Padding="10,7">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SecureIcon" FontFamily="Segoe MDL2 Assets"
                           FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="SecureText" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 图标 + 字段 -->
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 强调色圆底问号 -->
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                    Background="{StaticResource AccentBrush}" VerticalAlignment="Top">
                <TextBlock Text="?" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource OnAccentBrush}" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="2">
                <!-- 用户名 -->
                <StackPanel x:Name="UsernamePanel">
                    <TextBlock Text="用户名：" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="UsernameBox" Style="{StaticResource DarkTextBox}"/>
                </StackPanel>

                <!-- 密码 -->
                <StackPanel x:Name="PasswordPanel" Margin="0,10,0,0">
                    <TextBlock Text="密码：" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource DarkPasswordBox}"/>
                </StackPanel>

                <!-- 记住密码 -->
                <CheckBox x:Name="KeepPasswordCheck" Content="记住密码以便重新连接"
                          Style="{StaticResource DarkCheckBox}" Margin="0,10,0,0"/>

                <!-- CapsLock 提示 -->
                <TextBlock x:Name="CapsWarn" Text="⚠ 大写锁定已开启"
                           FontSize="11" Foreground="{StaticResource ErrBrush}"
                           Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <!-- 底部按钮：取消（Ghost）+ 确定（Filled），右对齐 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Style="{StaticResource GhostButton}"
                    Width="88" Height="34" FontSize="13" IsCancel="True"/>
            <Button Content="确定" Style="{StaticResource AccentButton}"
                    Width="88" Height="34" Margin="8,0,0,0" IsDefault="True"
                    Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
