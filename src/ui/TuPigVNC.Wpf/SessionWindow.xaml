<Window x:Class="TuPigVNC.Wpf.SessionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TuPigVNC" Icon="/TuPigVNC;component/Assets/TuPigVNC.ico" Width="1120" Height="780" MinWidth="720" MinHeight="480"
 Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
 FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14"
 TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
 UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen"
 Closing="Window_Closing" Deactivated="Window_Deactivated"
 PreviewKeyDown="Window_KeyDown" PreviewKeyUp="Window_KeyUp">
 <Window.Resources>
  <Style x:Key="SessionToolButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
   <Setter Property="MinHeight" Value="36"/>
   <Setter Property="Padding" Value="12,6"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="Height" Value="Auto"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="6"
       Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="ButtonSurface" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="ButtonSurface" Property="Background" Value="{StaticResource CardHoverBrush}"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.5"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="ToolIcon" TargetType="Path">
   <Setter Property="Width" Value="16"/>
   <Setter Property="Height" Value="16"/>
   <Setter Property="Stretch" Value="Uniform"/>
   <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
   <Setter Property="StrokeThickness" Value="1.6"/>
   <Setter Property="StrokeStartLineCap" Value="Round"/>
   <Setter Property="StrokeEndLineCap" Value="Round"/>
   <Setter Property="StrokeLineJoin" Value="Round"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
 </Window.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
   BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="16,12">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="远程会话" FontSize="12" Foreground="{StaticResource Text2Brush}" Margin="0,0,0,4"/>
      <TextBlock x:Name="ConnectionText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="远程连接地址"/>
     </StackPanel>
     <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="6"
      Padding="10,6" Margin="16,0,0,0" VerticalAlignment="Center">
      <TextBlock x:Name="FrameInfoText" Text="等待画面" Foreground="{StaticResource AccentBrush}" FontSize="12"/>
     </Border>
    </Grid>
    <WrapPanel x:Name="SessionToolbar" Grid.Row="1" KeyboardNavigation.TabNavigation="Continue">
     <Button x:Name="ScaleButton" Click="Scale_Click" Style="{StaticResource SessionToolButton}"
      IsEnabled="False" ToolTip="在适应窗口和原始大小之间切换；只改变本地显示，不修改远程分辨率"
      AutomationProperties.Name="切换远程画面缩放模式">
      <StackPanel Orientation="Horizontal">
       <Path Style="{StaticResource ToolIcon}" Data="M 2,7 L 2,2 7,2 M 13,2 L 18,2 18,7 M 18,13 L 18,18 13,18 M 7,18 L 2,18 2,13 M 7,10 L 13,10 M 10,7 L 10,13"/>
       <TextBlock x:Name="ScaleButtonText" Text="原始大小" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
     <Button Click="Refresh_Click" Style="{StaticResource SessionToolButton}" ToolTip="请求服务器重新发送完整画面"
      AutomationProperties.Name="刷新远程画面">
      <StackPanel Orientation="Horizontal">
       <Path Style="{StaticResource ToolIcon}" Data="M 17,8 A 7,7 0 1 0 17,13 M 17,2 L 17,8 11,8"/>
       <TextBlock Text="刷新画面" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
     <Button x:Name="FullscreenButton" Click="Fullscreen_Click" Style="{StaticResource SessionToolButton}"
      ToolTip="切换全屏；全屏时工具栏仍保留，可在这里退出" AutomationProperties.Name="进入全屏">
      <StackPanel Orientation="Horizontal">
       <Path Style="{StaticResource ToolIcon}" Data="M 7,2 L 2,2 2,7 M 13,2 L 18,2 18,7 M 18,13 L 18,18 13,18 M 7,18 L 2,18 2,13"/>
       <TextBlock x:Name="FullscreenButtonText" Text="进入全屏" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
     <Button Click="Disconnect_Click" Style="{StaticResource SessionToolButton}" Foreground="{StaticResource ErrBrush}"
      ToolTip="关闭当前会话并返回连接窗口" AutomationProperties.Name="断开当前远程连接">
      <StackPanel Orientation="Horizontal">
       <Path Style="{StaticResource ToolIcon}" Data="M 3,2 L 3,18 11,18 M 8,10 L 19,10 M 15,6 L 19,10 15,14"/>
       <TextBlock Text="断开连接" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
    </WrapPanel>
   </Grid>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}"
   BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="16,8">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock x:Name="StatusText" Text="正在等待服务器发送远程画面…" Foreground="{StaticResource Text2Brush}"
      TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock Text="点击画面后，键盘和鼠标输入会发送到远程电脑。" FontSize="12"
      Foreground="{StaticResource Text3Brush}" Margin="0,4,12,0" TextWrapping="Wrap"/>
     <!-- 网络统计：帧率、带宽、累计流量。随渲染定时器一起刷新。 -->
     <TextBlock x:Name="StatsText" Text="统计等待中…" FontSize="11" FontFamily="Consolas"
      Foreground="{StaticResource Text3Brush}" Margin="0,6,12,0" TextWrapping="Wrap"/>
    </StackPanel>
    <TextBlock x:Name="ScaleStatusText" Grid.Column="1" Text="适应窗口" FontSize="12"
     Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
   </Grid>
  </Border>
  <Grid Background="{StaticResource BgBrush}">
   <ScrollViewer x:Name="DesktopViewport" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Focusable="False" CanContentScroll="False">
    <Image x:Name="DesktopImage" Stretch="Uniform" Focusable="True"
     AutomationProperties.Name="远程桌面画面" AutomationProperties.HelpText="点击画面后可操作远程电脑"
     MouseMove="Desktop_MouseMove" MouseDown="Desktop_MouseDown"
     MouseUp="Desktop_MouseUp" MouseWheel="Desktop_MouseWheel"/>
   </ScrollViewer>
   <StackPanel x:Name="WaitingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="24">
    <Path Width="48" Height="40" Stretch="Uniform" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
     Data="M 3,3 L 45,3 45,29 3,29 Z M 24,29 L 24,37 M 15,37 L 33,37" HorizontalAlignment="Center" Margin="0,0,0,16"/>
    <TextBlock Text="等待远程画面" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
    <TextBlock Text="收到服务器的第一帧后，会在这里显示真实桌面。" Foreground="{StaticResource Text2Brush}"
     TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
   </StackPanel>
  </Grid>
 </DockPanel>
</Window>
