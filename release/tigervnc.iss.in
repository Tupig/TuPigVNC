[Setup]
#ifdef WIN64
; 只允许在 64 位系统上安装，并装到 64 位目录/注册表。
; SetupArchitecture=x64 让安装器 exe 本身也是 64 位 PE（需 Inno Setup 7+，
; CI 通过 choco 安装 7.0 beta）。
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
SetupArchitecture=x64
#endif
AppName=TuPigVNC
AppVerName=TuPigVNC @VERSION@ (@BUILD@)
AppVersion=@VERSION@
AppPublisher=TuPigVNC 团队
AppPublisherURL=https://github.com/TuPig/TuPigVNC
AppSupportURL=https://github.com/TuPig/TuPigVNC/issues
DefaultDirName={pf}\TuPigVNC
DefaultGroupName=TuPigVNC
LicenseFile=@CMAKE_SOURCE_DIR@\LICENCE.TXT
; 安装程序图标
SetupIconFile=@CMAKE_SOURCE_DIR@\assets\icons\tupigvnc.ico
; 卸载入口图标
UninstallDisplayIcon={app}\vncviewer.exe
; 自更新支持：自动关闭并重启正在运行的实例
CloseApplications=yes
RestartApplications=yes
; 静默安装时不在语言选择页停留
DisableDirPage=auto
DisableProgramGroupPage=auto
; 安装界面使用现代风格
WizardStyle=modern
; 允许在控制面板中以中文显示
AppComments=跨平台 VNC 远程桌面客户端

[Languages]
Name: "chinesesimplified"; MessagesFile: "@CMAKE_SOURCE_DIR@\release\Languages\ChineseSimplified.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"
Name: "quicklaunchicon"; Description: "{cm:CreateQuickLaunchIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Dirs]
; 配置 / 日志目录：安装时创建，并放行普通用户写入
; （装在 Program Files 下时，非管理员用户默认无法写入）。
; uninsneveruninstall：卸载时保留用户数据（连接历史、选项、日志）。
Name: "{app}\User"; Permissions: users-modify; Flags: uninsneveruninstall
Name: "{app}\logs"; Permissions: users-modify; Flags: uninsneveruninstall

[Files]
Source: "@CMAKE_BINARY_DIR@\src\vncviewer\Release\vncviewer.exe"; DestDir: "{app}"; Flags: ignoreversion restartreplace;
Source: "@CMAKE_SOURCE_DIR@\README.rst"; DestDir: "{app}\doc"; Flags: ignoreversion
Source: "@CMAKE_SOURCE_DIR@\LICENCE.TXT"; DestDir: "{app}\doc"; Flags: ignoreversion

#define LINGUAS
#define Lang
#sub AddLanguage
  #define Lang = FileRead(LINGUAS)
  Source: "@CMAKE_BINARY_DIR@\i18n\{#Lang}.mo"; DestDir: "{app}\locale\{#Lang}\LC_MESSAGES"; DestName: "tigervnc.mo"; Flags: ignoreversion
#endsub
#for {LINGUAS = FileOpen("@CMAKE_SOURCE_DIR@\i18n\LINGUAS"); !FileEof(LINGUAS); ""} AddLanguage

[Icons]
; 开始菜单
Name: "{group}\TuPigVNC"; FileName: "{app}\vncviewer.exe"; IconFilename: "{app}\vncviewer.exe"
Name: "{group}\监听模式 TuPigVNC"; FileName: "{app}\vncviewer.exe"; Parameters: "-listen"; IconFilename: "{app}\vncviewer.exe"
Name: "{group}\许可证"; FileName: "write.exe"; Parameters: "LICENCE.TXT"; WorkingDir: "{app}\doc"; Flags: "useapppaths"
Name: "{group}\发行说明"; FileName: "write.exe"; Parameters: "README.rst"; WorkingDir: "{app}\doc"; Flags: "useapppaths"
Name: "{group}\卸载 TuPigVNC"; FileName: "{uninstallexe}"; WorkingDir: "{app}";
; 桌面快捷方式
Name: "{autodesktop}\TuPigVNC"; FileName: "{app}\vncviewer.exe"; IconFilename: "{app}\vncviewer.exe"; Tasks: desktopicon
; 快速启动栏
Name: "{userappdata}\Microsoft\Internet Explorer\Quick Launch\TuPigVNC"; FileName: "{app}\vncviewer.exe"; Tasks: quicklaunchicon

[Run]
; 安装完成后可直接启动
Filename: "{app}\vncviewer.exe"; Description: "{cm:LaunchProgram,TuPigVNC}"; Flags: nowait postinstall skipifsilent

[Code]
{ 删除注册表键及其所有子键 }
procedure RegDeleteTree(RootKey: Integer; const SubKey: String);
begin
  RegDeleteKeyIncludingSubkeys(RootKey, SubKey);
end;

{ 安装前清理旧版本（0.0.1 / 0.0.2）残留的配置 / 日志 / 注册表。
  之后版本完全靠自身自动更新升级，不再依赖安装包迁移。

  注意：升级时（检测到已安装过）必须原样保留用户数据，只做全新安装的清理，
  否则用户连过的历史、选项会被安装包抹掉。 }
procedure DeleteOldVersionData();
var
  Dir: String;
begin
  // 安装目录已有主程序 = 升级，保留用户数据
  if FileExists(ExpandConstant('{app}\vncviewer.exe')) then
    exit;

  Dir := ExpandConstant('{userappdata}\TuPigVNC');
  if DirExists(Dir) then DelTree(Dir, True, True, True);

  Dir := ExpandConstant('{localappdata}\TuPigVNC');
  if DirExists(Dir) then DelTree(Dir, True, True, True);

  RegDeleteTree(HKEY_CURRENT_USER, 'Software\TuPigVNC');
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssInstall then
    DeleteOldVersionData();
end;
