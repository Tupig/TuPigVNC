[Setup]
#ifdef WIN64
ArchitecturesInstallIn64BitMode=x64
#endif
AppName=TuPigVNC
AppVerName=TuPigVNC @VERSION@ (@BUILD@)
AppVersion=@VERSION@
AppPublisher=TuPigVNC 团队
AppPublisherURL=https://github.com/TuPig/TuPigVNC
AppSupportURL=https://github.com/TuPig/TuPigVNC/issues
DefaultDirName={pf}\TuPigVNC
DefaultGroupName=TuPigVNC
LicenseFile=@CMAKE_SOURCE_DIR@\LICENCE.TXT
; 安装程序图标
SetupIconFile=@CMAKE_SOURCE_DIR@\assets\icons\tupigvnc.ico
; 卸载入口图标
UninstallDisplayIcon={app}\vncviewer.exe
; 自更新支持：自动关闭并重启正在运行的实例
CloseApplications=yes
RestartApplications=yes
; 静默安装时不在语言选择页停留
DisableDirPage=auto
DisableProgramGroupPage=auto
; 安装界面使用现代风格
WizardStyle=modern
; 允许在控制面板中以中文显示
AppComments=跨平台 VNC 远程桌面客户端

[Languages]
Name: "chinesesimplified"; MessagesFile: "@CMAKE_SOURCE_DIR@\release\Languages\ChineseSimplified.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"
Name: "quicklaunchicon"; Description: "{cm:CreateQuickLaunchIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "@CMAKE_BINARY_DIR@\src\vncviewer\Release\vncviewer.exe"; DestDir: "{app}"; Flags: ignoreversion restartreplace;
Source: "@CMAKE_SOURCE_DIR@\README.rst"; DestDir: "{app}"; Flags: ignoreversion
Source: "@CMAKE_SOURCE_DIR@\LICENCE.TXT"; DestDir: "{app}"; Flags: ignoreversion

#define LINGUAS
#define Lang
#sub AddLanguage
  #define Lang = FileRead(LINGUAS)
  Source: "@CMAKE_BINARY_DIR@\i18n\{#Lang}.mo"; DestDir: "{app}\locale\{#Lang}\LC_MESSAGES"; DestName: "tigervnc.mo"; Flags: ignoreversion
#endsub
#for {LINGUAS = FileOpen("@CMAKE_SOURCE_DIR@\i18n\LINGUAS"); !FileEof(LINGUAS); ""} AddLanguage

[Icons]
; 开始菜单
Name: "{group}\TuPigVNC"; FileName: "{app}\vncviewer.exe"; IconFilename: "{app}\vncviewer.exe"
Name: "{group}\监听模式 TuPigVNC"; FileName: "{app}\vncviewer.exe"; Parameters: "-listen"; IconFilename: "{app}\vncviewer.exe"
Name: "{group}\许可证"; FileName: "write.exe"; Parameters: "LICENCE.TXT"; WorkingDir: "{app}"; Flags: "useapppaths"
Name: "{group}\发行说明"; FileName: "write.exe"; Parameters: "README.rst"; WorkingDir: "{app}"; Flags: "useapppaths"
Name: "{group}\卸载 TuPigVNC"; FileName: "{uninstallexe}"; WorkingDir: "{app}";
; 桌面快捷方式
Name: "{autodesktop}\TuPigVNC"; FileName: "{app}\vncviewer.exe"; IconFilename: "{app}\vncviewer.exe"; Tasks: desktopicon
; 快速启动栏
Name: "{userappdata}\Microsoft\Internet Explorer\Quick Launch\TuPigVNC"; FileName: "{app}\vncviewer.exe"; Tasks: quicklaunchicon

[Run]
; 安装完成后可直接启动
Filename: "{app}\vncviewer.exe"; Description: "{cm:LaunchProgram,TuPigVNC}"; Flags: nowait postinstall skipifsilent
