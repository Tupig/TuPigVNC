#: unix/w0vncserver/w0vncserver.cxx:82 unix/x0vncserver/x0vncserver.cxx:289
msgid ""
"\n"
"Usage: %s [<parameters>]\n"
"       %s --version\n"
msgstr ""
"\n"
"用法：%s [<参数>]\n"
"       %s --version\n"

#: vncviewer/vncviewer.cxx:396
msgid ""
"\n"
"Usage: %s [parameters] [host][:displayNum]\n"
"       %s [parameters] [host][::port]\n"
"       %s [parameters] -listen [port]\n"
"       %s [parameters] [.tigervnc file]\n"
msgstr ""
"\n"
"用法：%s [参数] [主机][:显示号]\n"
"       %s [参数] [主机][::端口]\n"
"       %s [参数] -listen [端口]\n"
"       %s [参数] [.tigervnc 文件]\n"

#: vncviewer/vncviewer.cxx:404
msgid ""
"\n"
"Usage: %s [parameters] [host][:displayNum]\n"
"       %s [parameters] [host][::port]\n"
"       %s [parameters] [unix socket]\n"
"       %s [parameters] -listen [port]\n"
"       %s [parameters] [.tigervnc file]\n"
msgstr ""
"\n"
"用法：%s [参数] [主机][:显示编号]\n"
"      %s [参数] [主机][::端口]\n"
"      %s [参数] [unix 套接字]\n"
"      %s [参数] -listen [端口]\n"
"      %s [参数] [.tigervnc 文件]\n"

