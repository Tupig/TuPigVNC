<?xml version="1.0" encoding="utf-8"?>
<!--
  TuPigVNC · NuGet 隔离配置

  所有 NuGet 包统一还原到 G:\VNCView\.claude\nuget\，不污染用户级
  %USERPROFILE%\.nuget\packages。

  .claude\ 不入库；换机器时 `dotnet restore` 会按本文件重新拉取。
-->
<configuration>
  <config>
    <add key="globalPackagesFolder" value=".claude/nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
