<?xml version="1.0" encoding="utf-8"?>
<!--
  TuPigVNC · NuGet 隔离配置

  所有 NuGet 包统一还原到项目 tmp/nuget/packages，不污染用户级
  %USERPROFILE%\.nuget\packages。

  tool/packages/nuget 是入库的离线依赖源；tmp/ 是可重建的解包缓存，不入库。
  离线验收须显式指定本地源和全新缓存，不能依靠已有全局缓存掩盖缺包。
-->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="tmp/nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="project-offline" value="tool/packages/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
