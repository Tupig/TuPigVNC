; TuPigVNC · WPF 安装脚本
;
; 目录结构（按 .claude/design/DESIGN.md 第六节）：
;   TuPigVNC/
;     ├─ bin/       TuPigVNC.exe + 托管应用 DLL + .NET 运行时 + TuPigVNC.Core.dll
;     ├─ share/     doc/ + locale/
;     ├─ User/      历史、配置（首次运行生成，卸载保留）
;     ├─ logs/      日志（首次运行生成，卸载保留）
;     └─ LICENCE.TXT, README.rst   （根目录快捷副本）
;
; 注意：TuPigVNC.Core.dll 必须和 TuPigVNC.exe 同目录（P/Invoke 按 exe 目录加载）。
;
; 本文件由 CMake configure_file 生成，@VAR@ 为替换占位符。

[Setup]
#ifdef WIN64
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
SetupArchitecture=x64
#endif
AppName=TuPigVNC
AppVerName=TuPigVNC @VERSION@
AppVersion=@VERSION@
AppPublisher=TuPigVNC 团队
AppPublisherURL=https://github.com/TuPig/TuPigVNC
AppSupportURL=https://github.com/TuPig/TuPigVNC/issues
DefaultDirName={pf}\TuPigVNC
DefaultGroupName=TuPigVNC
LicenseFile=@CMAKE_SOURCE_DIR@\LICENCE.TXT
SetupIconFile=@CMAKE_SOURCE_DIR@\src\assets\icons\tupigvnc.ico
UninstallDisplayIcon={app}\bin\TuPigVNC.exe
CloseApplications=yes
RestartApplications=yes
DisableDirPage=auto
DisableProgramGroupPage=auto
WizardStyle=modern
AppComments=跨平台 VNC 远程桌面客户端

[Languages]
Name: "chinesesimplified"; MessagesFile: "@CMAKE_SOURCE_DIR@\build-support\release\Languages\ChineseSimplified.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"
Name: "quicklaunchicon"; Description: "{cm:CreateQuickLaunchIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Dirs]
; 用户数据与日志：安装时创建并放行普通用户写入（装在 Program Files 下时默认只读）。
; uninsneveruninstall：卸载时保留用户数据。
Name: "{app}\User"; Permissions: users-modify; Flags: uninsneveruninstall
Name: "{app}\logs"; Permissions: users-modify; Flags: uninsneveruninstall

[Files]
; ---- bin/：主程序 + 托管应用 + .NET / WinAppSDK 运行时 + 原生核心 ----
; 除 share\ 以外的所有发布文件都归 bin\。
Source: "@TUPIGVNC_PUBLISH_DIR@\*"; DestDir: "{app}\bin"; Excludes: "\share\*, \doc\*, \locale\*"; Flags: ignoreversion recursesubdirs createallsubdirs

; ---- share/：文档 ----
Source: "@CMAKE_SOURCE_DIR@\doc\README.rst"; DestDir: "{app}\share\doc"; Flags: ignoreversion
Source: "@CMAKE_SOURCE_DIR@\LICENCE.TXT"; DestDir: "{app}\share\doc"; Flags: ignoreversion

; ---- 根目录快捷副本（兼容旧版「双击看文档」习惯）----
Source: "@CMAKE_SOURCE_DIR@\doc\README.rst"; DestDir: "{app}"; Flags: ignoreversion
Source: "@CMAKE_SOURCE_DIR@\LICENCE.TXT"; DestDir: "{app}"; Flags: ignoreversion

; ---- share/locale：i18n ----
#define LINGUAS
#define Lang
#sub AddLanguage
  #define Lang = FileRead(LINGUAS)
  Source: "@CMAKE_BINARY_DIR@\i18n\{#Lang}.mo"; DestDir: "{app}\share\locale\{#Lang}\LC_MESSAGES"; DestName: "tigervnc.mo"; Flags: ignoreversion
#endsub
#for {LINGUAS = FileOpen("@CMAKE_SOURCE_DIR@\src\i18n\LINGUAS"); !FileEof(LINGUAS); ""} AddLanguage

[Icons]
; 开始菜单
Name: "{group}\TuPigVNC"; FileName: "{app}\bin\TuPigVNC.exe"; IconFilename: "{app}\bin\TuPigVNC.exe"
Name: "{group}\监听模式 TuPigVNC"; FileName: "{app}\bin\TuPigVNC.exe"; Parameters: "-listen"; IconFilename: "{app}\bin\TuPigVNC.exe"
Name: "{group}\许可证"; FileName: "{sys}\notepad.exe"; Parameters: """{app}\share\doc\LICENCE.TXT"""
Name: "{group}\发行说明"; FileName: "{sys}\notepad.exe"; Parameters: """{app}\share\doc\README.rst"""
Name: "{group}\卸载 TuPigVNC"; FileName: "{uninstallexe}"; WorkingDir: "{app}";
; 桌面快捷方式
Name: "{autodesktop}\TuPigVNC"; FileName: "{app}\bin\TuPigVNC.exe"; IconFilename: "{app}\bin\TuPigVNC.exe"; Tasks: desktopicon
; 快速启动栏
Name: "{userappdata}\Microsoft\Internet Explorer\Quick Launch\TuPigVNC"; FileName: "{app}\bin\TuPigVNC.exe"; Tasks: quicklaunchicon

[Run]
Filename: "{app}\bin\TuPigVNC.exe"; Description: "{cm:LaunchProgram,TuPigVNC}"; Flags: nowait postinstall skipifsilent

[Code]
procedure RegDeleteTree(RootKey: Integer; const SubKey: String);
begin
  RegDeleteKeyIncludingSubkeys(RootKey, SubKey);
end;

{ 全新安装时清理旧版本（0.0.1 / 0.0.2）残留的配置 / 日志 / 注册表。
  升级时（安装目录已有主程序）必须原样保留用户数据。 }
procedure DeleteOldVersionData();
var
  Dir: String;
begin
  if FileExists(ExpandConstant('{app}\bin\TuPigVNC.exe')) then
    exit;
  if FileExists(ExpandConstant('{app}\vncviewer.exe')) then
    exit;

  Dir := ExpandConstant('{userappdata}\TuPigVNC');
  if DirExists(Dir) then DelTree(Dir, True, True, True);

  Dir := ExpandConstant('{localappdata}\TuPigVNC');
  if DirExists(Dir) then DelTree(Dir, True, True, True);

  RegDeleteTree(HKEY_CURRENT_USER, 'Software\TuPigVNC');
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssInstall then
    DeleteOldVersionData();
end;
